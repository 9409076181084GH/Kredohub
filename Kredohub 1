-- Enable RLS for demo: permissive policies
create extension if not exists "uuid-ossp";
create table if not exists agents (
  id uuid primary key default uuid_generate_v4(),
  email text unique not null,
  name text not null,
  phone text,
  role text not null check (role in ('Admin','Manager','Agent')),
  password_hash text not null,
  status text default 'active',
  created_at timestamp default now(),
  last_login timestamp,
  leads_assigned int default 0
);
create table if not exists leads (
  id uuid primary key default uuid_generate_v4(),
  first_name text, last_name text, id_number text, dob date,
  phone text, email text, province text, city text, address text,
  marital_status text, marriage_type text,
  spouse_first_name text, spouse_last_name text, spouse_id_number text,
  spouse_phone text, spouse_employer text, spouse_gross numeric, spouse_net numeric,
  employer text, position text, gross_salary numeric, net_salary numeric,
  additional_income numeric, salary_date int,
  bank text, branch_code text, account_number text, account_type text,
  product_ids text[], status text, assigned_to uuid references agents(id),
  created_at timestamp default now(), consent boolean
);
create table if not exists clients (
  id uuid primary key default uuid_generate_v4(),
  lead_id uuid references leads(id),
  name text, email text, phone text, product text,
  status text, monthly_fee numeric, next_billing date
);
create table if not exists tasks (id uuid primary key default uuid_generate_v4(), title text, due date, done boolean default false, assigned_to uuid references agents(id));
create table if not exists documents (id uuid primary key default uuid_generate_v4(), name text, type text, lead text, uploaded timestamp default now(), size text);

